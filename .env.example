# ═══════════════════════════════════════════════════════════
# Supabase (única instância — cloud ou self-hosted)
# ═══════════════════════════════════════════════════════════
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Nome amigável da instância (apenas para logs)
SUPABASE_INSTANCE_NAME=

# ═══════════════════════════════════════════════════════════
# SSH — necessário para deploy de Edge Functions na VPS
# ═══════════════════════════════════════════════════════════
SSH_HOST=
SSH_PORT=
SSH_USERNAME=
# Use SSH_PASSWORD ou SSH_PRIVATE_KEY_PATH (não ambos)
SSH_PASSWORD=
# SSH_PRIVATE_KEY_PATH=
# SSH_PASSPHRASE= # se a chave privada tiver passphrase

# ═══════════════════════════════════════════════════════════
# Paths na VPS (obrigatórios)
# ═══════════════════════════════════════════════════════════
SUPABASE_DOCKER_PATH=
SUPABASE_FUNCTIONS_CONTAINER=
